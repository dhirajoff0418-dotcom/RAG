# BookRag — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# How to apply on Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^([^#=]+)=(.*)') {
#       [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process')
#     }
#   }

# ── Required ─────────────────────────────────────────────────────────────────
# Your Groq API key.  Get a free one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Settings (optional) ──────────────────────────────────────────────────
# See https://console.groq.com/docs/models for available model IDs.
# llama-3.3-70b-versatile is now Enterprise-only. Free-tier options:
#   openai/gpt-oss-120b  (500 t/s, $0.15/1M input tokens)
#   openai/gpt-oss-20b   (1000 t/s, $0.075/1M input tokens)
GROQ_MODEL=openai/gpt-oss-120b

# Temperature: 0.0 = deterministic/factual, 1.0 = creative.
# Keep low for RAG to minimise hallucination.
LLM_TEMPERATURE=0.1

# ── Retrieval Settings (optional) ────────────────────────────────────────────
# Number of top chunks to retrieve per query.
RETRIEVAL_TOP_K=5

# Minimum cosine similarity (0–1) for a chunk to be included.
# Raise to 0.5+ for stricter relevance, lower to 0.1 for more recall.
# Default is 0.15 — 0.3 was too aggressive for informal paraphrase queries.
SIMILARITY_THRESHOLD=0.15

# ── Chunking Settings (optional) ─────────────────────────────────────────────
# Maximum characters per chunk (approximate).
# Larger chunks preserve more context (e.g. name + relationship in one passage).
CHUNK_MAX_CHARS=1000

# Sentences of overlap between consecutive chunks.
CHUNK_OVERLAP_SENTENCES=2

# ── Storage Settings (optional) ──────────────────────────────────────────────
# Directory where vector JSON files are stored.
DATA_DIRECTORY=./data

# Active knowledge-base collection name.
# Different names produce separate JSON files, e.g. "research", "docs".
COLLECTION_NAME=default

# ── Web Loader Settings (optional) ───────────────────────────────────────────
# HTTP request timeout in seconds when fetching URLs.
WEB_TIMEOUT_SECONDS=30
