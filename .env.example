# BookRag — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# How to apply on Windows PowerShell:
#   Get-Content .env | ForEach-Object {
#     if ($_ -match '^([^#=]+)=(.*)') {
#       [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process')
#     }
#   }

# ── Required ─────────────────────────────────────────────────────────────────
# Your Groq API key.  Get a free one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Settings (optional) ──────────────────────────────────────────────────
# See https://console.groq.com/docs/models for available model IDs.
# llama-3.3-70b-versatile is now Enterprise-only. Free-tier options:
#   openai/gpt-oss-120b  (500 t/s, $0.15/1M input tokens)
#   openai/gpt-oss-20b   (1000 t/s, $0.075/1M input tokens)
GROQ_MODEL=openai/gpt-oss-120b

# Temperature: 0.0 = deterministic/factual, 1.0 = creative.
# Keep low for RAG to minimise hallucination.
LLM_TEMPERATURE=0.1

# ── Retrieval Settings (optional) ────────────────────────────────────────────
# Number of final chunks passed to the LLM as context.
RETRIEVAL_TOP_K=6

# Minimum cosine similarity (0–1) for a chunk to pass the VECTOR filter.
# BM25 hits are not filtered by this value.
# 0.15 works well; lower = more recall but noisier context.
SIMILARITY_THRESHOLD=0.15

# How many candidates each of vector search and BM25 return before RRF merging.
# Higher = more recall at the cost of slightly more reranking work.
RETRIEVAL_CANDIDATE_K=20

# ── Hybrid Search / BM25 (optional) ──────────────────────────────────────────
# BM25 k1: term-frequency saturation. Typical range 1.2–2.0.
BM25_K1=1.5
# BM25 b: length normalisation. Range 0 (none) to 1 (full).
BM25_B=0.75

# ── Query Rewriting (optional) ────────────────────────────────────────────────
# When true, the LLM expands the user question into 3 search rewrites before
# retrieval, improving recall on paraphrase-sensitive embedding models.
QUERY_REWRITE=true

# ── Reranking (optional) ──────────────────────────────────────────────────────
# When true, the top RERANK_CANDIDATE_K chunks are scored 0–10 by the LLM for
# relevance before the final top-K is selected.  Improves precision significantly.
RERANK=true
RERANK_CANDIDATE_K=20

# ── Chunking Settings (optional) ─────────────────────────────────────────────
# Maximum characters per chunk body (before the page/chapter prefix is added).
# Smaller = more precise retrieval; larger = more context per chunk.
# The all-MiniLM-L6-v2 model truncates at ~256 tokens (~900 chars including prefix).
CHUNK_MAX_CHARS=500

# Sentences of overlap between consecutive chunks.
# 2 gives good context continuity without excessive duplication.
CHUNK_OVERLAP_SENTENCES=2

# ── Embedding Settings (optional) ────────────────────────────────────────────
# Identifier for the embedding model.  Must match what was used at ingest time.
# The system will refuse to run queries if this differs from the stored value.
# Default (and only built-in option): all-MiniLM-L6-v2
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Storage Settings (optional) ──────────────────────────────────────────────
# Directory where vector JSON files are stored.
DATA_DIRECTORY=./data

# Active knowledge-base collection name.
# Different names produce separate JSON files, e.g. "research", "docs".
COLLECTION_NAME=default

# ── Web Loader Settings (optional) ───────────────────────────────────────────
# HTTP request timeout in seconds when fetching URLs.
WEB_TIMEOUT_SECONDS=30

# ── Debug (optional) ─────────────────────────────────────────────────────────
# Set to true to always print retrieval diagnostics, or pass --debug per-query.
DEBUG=false
