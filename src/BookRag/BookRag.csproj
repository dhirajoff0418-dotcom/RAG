<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Single RootNamespace so all files share the same base namespace -->
    <RootNamespace>BookRag</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Local ONNX embedding model (all-MiniLM-L6-v2) — no external API needed -->
    <PackageReference Include="SmartComponents.LocalEmbeddings" Version="0.1.0-preview10148" />

    <!-- Pure-managed PDF text extraction — no native dependencies required -->
    <PackageReference Include="PdfPig" Version="0.1.9" />

    <!-- HTML parsing for web page ingestion -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
  </ItemGroup>

</Project>
